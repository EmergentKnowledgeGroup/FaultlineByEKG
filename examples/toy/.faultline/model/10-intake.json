{
  "schema": "faultline.model/1",
  "boxes": [
    { "id": "web.submit", "stage": "s_intake", "kind": "external", "title": "Web client sends a parcel", "handle": "StatusClient",
      "plain": "The web status client posts the parcel to /api/parcels and gets back an accepted receipt or a refused answer with a reason code. Server errors are retried 3 times, then thrown.",
      "why": "The only way a person outside the machine reaches intake.",
      "status": "live",
      "refs": [{ "path": "web/client.ts", "symbol": "web/client.ts::StatusClient.submit", "line": 32 }],
      "inputs": ["parcel JSON"], "outputs": ["accepted or refused answer"], "failure": "A 5xx answer is retried 3 times, then an Error is thrown" },
    { "id": "intake.submit", "stage": "s_intake", "kind": "step", "title": "Take the submit request", "handle": "cmd_submit",
      "plain": "The submit command wraps intake. It answers ok with a receipt, or ok false with the refusal code and message. A refusal is an answer, not a crash.",
      "status": "live",
      "refs": [{ "path": "parcelworks/cli.py", "symbol": "parcelworks/cli.py::cmd_submit", "line": 14 }],
      "inputs": ["raw parcel dict"], "outputs": ["receipt or refusal"] },
    { "id": "intake.required", "stage": "s_intake", "kind": "gate", "title": "Check required fields", "handle": "missing_field",
      "plain": "Id, sender, recipient, postcode and weight_g must all be present and non-empty. A zero weight counts as missing.",
      "status": "live",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 16 }],
      "failure": "Refused as missing_field" },
    { "id": "intake.weight", "stage": "s_intake", "kind": "gate", "title": "Check weight against limit", "handle": "overweight",
      "plain": "The weight must be a positive whole number of grams and at most MAX_WEIGHT_G (30000 by default). Anything else is refused as bad_weight or overweight.",
      "why": "Keeps parcels the carrier cannot take out of the queue.",
      "status": "default-on", "switch": "switch:MAX_WEIGHT_G",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 21 },
               { "path": "parcelworks/config.py", "symbol": "parcelworks/config.py::max_weight_g", "line": 17 }],
      "failure": "Refused as bad_weight or overweight" },
    { "id": "intake.format", "stage": "s_intake", "kind": "gate", "title": "Check postcode and service", "handle": "bad_postcode",
      "plain": "The postcode must be 5 capital letters or digits. The service must be standard or express, and defaults to standard.",
      "status": "live",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 23 }],
      "outputs": ["a Parcel record"], "failure": "Refused as bad_postcode or bad_service" },
    { "id": "intake.dedupe", "stage": "s_intake", "kind": "decision", "title": "Look for a duplicate id", "handle": "duplicate",
      "plain": "accept asks the queue whether this parcel id already exists. A repeat id is refused and nothing is overwritten.",
      "status": "live",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::accept", "line": 36 },
               { "path": "parcelworks/jobqueue.py", "symbol": "parcelworks/jobqueue.py::Queue.exists", "line": 59 }],
      "failure": "Refused as duplicate" },
    { "id": "intake.lane", "stage": "s_intake", "kind": "decision", "title": "Choose the lane", "handle": "FAST_LANE",
      "plain": "With FAST_LANE on, an express parcel of 500 g or less skips the queue. With it off, which is the default, every parcel takes the normal lane.",
      "status": "live",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::accept", "line": 38 },
               { "path": "parcelworks/config.py", "symbol": "parcelworks/config.py::fast_lane", "line": 7 }] },
    { "id": "intake.fast_done", "stage": "s_intake", "kind": "step", "title": "Record as done at intake", "handle": "fast lane",
      "plain": "The parcel is stored already done, with no carrier label and no worker involved. Used only when FAST_LANE=1.",
      "why": "Lets tiny express parcels skip the backlog.",
      "status": "off", "switch": "switch:FAST_LANE",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::accept", "line": 39 },
               { "path": "parcelworks/jobqueue.py", "symbol": "parcelworks/jobqueue.py::Queue.enqueue", "line": 70 }],
      "outputs": ["a done job row with no label"] },
    { "id": "intake.enqueue", "stage": "s_intake", "kind": "step", "title": "Put the parcel in line", "handle": "enqueue",
      "plain": "The parcel is stored as a pending job and a normal-lane receipt is returned.",
      "status": "live",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::accept", "line": 41 },
               { "path": "parcelworks/jobqueue.py", "symbol": "parcelworks/jobqueue.py::Queue.enqueue", "line": 71 },
               { "path": "parcelworks/schema.py", "symbol": "parcelworks/schema.py::Parcel.to_dict", "line": 42 }],
      "outputs": ["a pending job row", "receipt with lane normal"] },
    { "id": "intake.refused", "stage": "s_intake", "kind": "end", "title": "Parcel refused", "handle": "Refusal",
      "plain": "The caller gets the refusal code and message and nothing is stored. Codes: missing_field, bad_weight, overweight, bad_postcode, bad_service, duplicate.",
      "status": "live", "outcome": "refusal",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 17 },
               { "path": "parcelworks/schema.py", "symbol": "parcelworks/schema.py::Refusal.__init__", "line": 26 }] }
  ],
  "routes": [
    { "id": "r_web_submit", "from": "web.submit", "to": "intake.submit", "type": "forward", "when": "",
