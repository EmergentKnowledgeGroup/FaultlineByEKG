    { "id": "r_required_ok", "from": "intake.required", "to": "intake.weight", "type": "forward", "when": "All required fields set",
      "why": "Every required key is present and non-empty.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 18 }], "inferred": false },
    { "id": "r_required_bad", "from": "intake.required", "to": "intake.refused", "type": "forward", "when": "A required field is empty",
      "why": "The first empty or missing key raises Refusal missing_field.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 17 }], "inferred": false },
    { "id": "r_weight_ok", "from": "intake.weight", "to": "intake.format", "type": "forward", "when": "Weight within the limit",
      "why": "A positive whole number of grams at or under MAX_WEIGHT_G.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 23 }], "inferred": false },
    { "id": "r_weight_bad", "from": "intake.weight", "to": "intake.refused", "type": "forward", "when": "Weight bad or over limit",
      "why": "Not a positive whole number raises bad_weight; above MAX_WEIGHT_G raises overweight.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 22 }], "inferred": false },
    { "id": "r_shape_ok", "from": "intake.format", "to": "intake.dedupe", "type": "forward", "when": "Postcode and service valid",
      "why": "The postcode matches the 5-character pattern and the service is standard or express.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 28 }], "inferred": false },
    { "id": "r_shape_bad", "from": "intake.format", "to": "intake.refused", "type": "forward", "when": "Postcode or service bad",
      "why": "A malformed postcode raises bad_postcode; an unknown service raises bad_service.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::validate", "line": 24 }], "inferred": false },
    { "id": "r_dedupe_new", "from": "intake.dedupe", "to": "intake.lane", "type": "forward", "when": "Id not seen before",
