    { "id": "r_dedupe_dup", "from": "intake.dedupe", "to": "intake.refused", "type": "forward", "when": "Id already known",
      "why": "The queue already has a row with this id, so intake raises Refusal duplicate.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::accept", "line": 37 }], "inferred": false },
    { "id": "r_lane_fast", "from": "intake.lane", "to": "intake.fast_done", "type": "forward", "when": "FAST_LANE on, small express",
      "why": "config.fast_lane() is true, the service is express and the weight is 500 g or less.",
      "refs": [{ "path": "parcelworks/intake.py", "symbol": "parcelworks/intake.py::accept", "line": 38 }], "inferred": false },
    { "id": "r_lane_normal", "from": "intake.lane", "to": "intake.enqueue", "type": "forward", "when": "Otherwise",
